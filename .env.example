# Mayday environment. Copy to .env.local (gitignored) and fill in what you use.
#
# The browser bundle reads NO environment variables: feature flags are URL switches
# (`?flag=elevenLabs`, `?fake=1`, `?debug=1`, `?guide=1`, src/flags.ts) and API keys never
# reach the client (docs/01 threat model). Never VITE_-prefix a key: Vite would inline it.
#
# The variables below are read by Node processes on the laptop only. Vite does not load
# .env files into vite.config.ts, so set the MAYDAY_* switches on the command line as
# documented in README.md, or export them in your shell.

# --- Dev server (vite.config.ts) ---------------------------------------------------------
# Serve plain http://localhost:5173 instead of self-signed https. Laptop only: phones need
# https for the camera. Usage: MAYDAY_HTTP=1 npm run dev
MAYDAY_HTTP=

# Use a trusted local CA via mkcert instead of the self-signed certificate. Asks for your
# macOS password once. Usage: MAYDAY_MKCERT=1 npm run dev
MAYDAY_MKCERT=

# --- ElevenLabs dev key proxy (src/voice/providers/devproxy.mjs, docs/09) ----------------
# Stand-in for the DigitalOcean /api/proxy function (docs/04 TODO 1) until it exists. The
# proxy reads this from the environment or from .env.local. Voice ids are chosen in code
# (docs/09), not here. Usage: node src/voice/providers/devproxy.mjs [port, default 8788]
ELEVENLABS_API_KEY=
