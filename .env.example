# Mayday environment. Copy to .env.local (gitignored) and fill in what you use.
#
# The browser bundle reads NO environment variables: feature flags are URL switches
# (`?flag=elevenLabs`, `?fake=1`, `?debug=1`, `?guide=1`, src/flags.ts) and API keys never
# reach the client (docs/01 threat model). Never VITE_-prefix a key: Vite would inline it.
#
# The variables below are read by Node processes on the laptop only. Vite does not load
# .env files into vite.config.ts, so set the MAYDAY_* switches on the command line as
# documented in README.md, or export them in your shell.

# --- Dev server (vite.config.ts) ---------------------------------------------------------
# Serve plain http://localhost:5173 instead of self-signed https. Laptop only: phones need
# https for the camera. Usage: MAYDAY_HTTP=1 npm run dev
MAYDAY_HTTP=

# Use a trusted local CA via mkcert instead of the self-signed certificate. Asks for your
# macOS password once. Usage: MAYDAY_MKCERT=1 npm run dev
MAYDAY_MKCERT=

# --- ElevenLabs key proxy (src/voice/providers/devproxy.mjs, docs/09) --------------------
# Stand-in for the DigitalOcean /api/proxy function (docs/04 TODO 1) until it exists. With a
# key present, `npm run dev` and `npm run preview` mount the proxy at /api/proxy on their own
# origin, so the phone reaches it over the same https URL it loaded the page from. Without a
# key the mount is skipped and every flagged voice feature stays on its local stub. Voice ids
# are chosen in code (docs/09), not here. Turn the features on per session with
# `?flag=elevenLabs`, `?flag=dispatcherSim`, or both: `?flag=elevenLabs,dispatcherSim`.
# Standalone: node src/voice/providers/devproxy.mjs [port, default 8788]
ELEVENLABS_API_KEY=

# The SIMULATED dispatcher agent (docs/04 TODO 3). Create it once per account with
# `node scripts/create-dispatcher-agent.mjs`, which prints this line. The proxy turns it into
# a signed session URL for the browser; the id itself never ships. Missing: the scripted
# dispatcher answers CALL 911 even with `?flag=dispatcherSim`.
ELEVENLABS_AGENT_ID=
